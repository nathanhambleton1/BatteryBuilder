	(text "Each port connects to a thermal resistor.\nTS2 is also used as a WAKE pin, with a\nthermistor connected it may prevent the \ndevice from ever fully entering SHUTDOWN mode."
		(exclude_from_sim no)
		(at 169.164 210.058 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "195634dc-6f9f-42c4-8207-e1c93c571ccf")
	)
	(text "Thermistor Connectors"
		(exclude_from_sim no)
		(at 184.912 204.47 0)
		(effects
			(font
				(size 1.905 1.905)
			)
		)
		(uuid "3dcde105-beef-4515-aa18-fa7abe28c1ee")
	)
	(text "Power Regulators"
		(exclude_from_sim no)
		(at 313.436 179.578 0)
		(effects
			(font
