	(text "Coulomb Counter"
		(exclude_from_sim no)
		(at 156.972 234.188 0)
		(effects
			(font
				(size 1.905 1.905)
			)
		)
		(uuid "840525a5-756a-4ce5-a16f-2c1de81a9eac")
	)
	(text "The NPN BJT, driven by the BREG pin, serves as the pre‑regulator that reduces the \nwide‑range battery voltage (4.7 V - 80 V), label CD, to a stable ~5.5 V suitable for the LDOs. \nThis 5.5 V appears on the REGIN pin, which is the input to the on‑board LDOs \n(REG1 and REG2); the LDOs then generate the precise output rails on the REG pins \n(e.g., 1.8 V, 2.5 V, 3.0 V, 3.3 V, or 5.0 V) for the rest of the BMS circuitry.\nFor this circuit REG1 is regulated to 3.3v and used for the MCU power & I2C connection."
		(exclude_from_sim no)
		(at 300.482 187.198 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "94ae69ba-9168-4d04-b8b5-95d0c996c4e6")
	)
	(text "Charge & Discharge FETs"
		(exclude_from_sim no)
		(at 257.048 33.02 0)
		(effects
			(font
				(size 1.905 1.905)
			)
		)
		(uuid "e16964d9-3546-4050-98c1-048e917d1bf3")
	)
	(text "Analog input pin connected to the internal coulomb counter \nperipheral for integrating a small voltage between SRP and \nSRN, where SRP is the top of the sense resistor. A charging \ncurrent generates a positive voltage at SRP relative to SRN."
		(exclude_from_sim no)
		(at 144.78 239.776 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "fd2a6c53-291f-46b8-81e6-bf6742ba344a")
	)
