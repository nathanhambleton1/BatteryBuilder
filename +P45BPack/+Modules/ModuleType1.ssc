component ModuleType1
    % ModuleType1:2
    % Module Block
    %    Model resolution: Detailed
    %    Number of parallel assemblies: 195
    %    Number of cells per parallel assembly: 1
    %
    %    MATLAB version: 25.2
    %    Simscape Battery version: 25.2
    %    Simscape code generated on: 02-Sep-2026 17:23:38

    parameters
        SOC_vecCell = {[0, .1, .25, .5, .75, .9, 1],'1'}; % Vector of state-of-charge values, SOC
        SOC_vecCellPercentDeviation = zeros([195 1]); % Percent deviation for SOC_vecCell
        V0_vecCell = {[3.5057, 3.566, 3.6337, 3.7127, 3.9259, 4.0777, 4.1928],'V'}; % Open-circuit voltage, V0(SOC)
        V0_vecCellPercentDeviation = zeros([195 1]); % Percent deviation for V0_vecCell
        V_rangeCell = {[0, inf],'V'}; % Terminal voltage operating range [Min Max]
        V_rangeCellPercentDeviation = zeros([195 1]); % Percent deviation for V_rangeCell
        R0_vecCell = {[.0085, .0085, .0087, .0082, .0083, .0085, .0085],'Ohm'}; % Terminal resistance, R0(SOC)
        R0_vecCellPercentDeviation = zeros([195 1]); % Percent deviation for R0_vecCell
        AHCell = {27,'A*hr'}; % Cell capacity, AH
        AHCellPercentDeviation = zeros([195 1]); % Percent deviation for AHCell
        extrapolation_optionCell = {simscape.enum.extrapolation.nearest,'1'}; % Extrapolation method for all tables
        R1_vecCell = {[.0029, .0024, .0026, .0016, .0023, .0018, .0017],'Ohm'}; % First polarization resistance, R1(SOC)
        R1_vecCellPercentDeviation = zeros([195 1]); % Percent deviation for R1_vecCell
        tau1_vecCell = {[36, 45, 105, 29, 77, 33, 39],'s'}; % First time constant, tau1(SOC)
        tau1_vecCellPercentDeviation = zeros([195 1]); % Percent deviation for tau1_vecCell
    end

    parameters(ExternalAccess=none)
        P = 1; % Batteries in Parallel
        S = 195; % Batteries in Series
        CellCount = P*S; % Number of cells in battery
    end

    nodes
        p = foundation.electrical.electrical; % +
        n = foundation.electrical.electrical; % -
    end

    variables
        iCell = {repmat(0,195,1),'A'}; % Cell current (positive in)
        vCell = {repmat(0,195,1),'V'}; % Cell terminal voltage
        socCell = {value={repmat(1,195,1),'1'},priority=priority.high}; % Cell state of charge
        numCyclesCell = {value={repmat(0,195,1),'1'},priority=priority.high}; % Cell discharge cycles
        vParallelAssembly = {value={repmat(0,195,1),'V'},priority=priority.none}; % Parallel Assembly Voltage
        socParallelAssembly = {value={repmat(1,195,1),'1'},priority=priority.none}; % Parallel Assembly state of charge
    end

    equations
        assert(length(iCell) == CellCount);
        assert(length(vCell) == CellCount);
        assert(length(socCell) == CellCount);
        assert(length(numCyclesCell) == CellCount);
        assert(length(vParallelAssembly) == S);
        assert(length(socParallelAssembly) == S);
        assert(isValidPercentDeviationSize(SOC_vecCellPercentDeviation,SOC_vecCell,S*P),...
            'Percent deviation for SOC_vecCell must contain a number of vertically concatenated elements equal to the number of cell models. Each element must be a scalar or equal to the size of the underlying parameter.');
        assert(isValidPercentDeviationSize(V0_vecCellPercentDeviation,V0_vecCell,S*P),...
            'Percent deviation for V0_vecCell must contain a number of vertically concatenated elements equal to the number of cell models. Each element must be a scalar or equal to the size of the underlying parameter.');
        assert(isValidPercentDeviationSize(V_rangeCellPercentDeviation,V_rangeCell,S*P),...
            'Percent deviation for V_rangeCell must contain a number of vertically concatenated elements equal to the number of cell models. Each element must be a scalar or equal to the size of the underlying parameter.');
        assert(isValidPercentDeviationSize(R0_vecCellPercentDeviation,R0_vecCell,S*P),...
            'Percent deviation for R0_vecCell must contain a number of vertically concatenated elements equal to the number of cell models. Each element must be a scalar or equal to the size of the underlying parameter.');
        assert(isValidPercentDeviationSize(AHCellPercentDeviation,AHCell,S*P),...
            'Percent deviation for AHCell must contain a number of vertically concatenated elements equal to the number of cell models. Each element must be a scalar or equal to the size of the underlying parameter.');
        assert(isValidPercentDeviationSize(R1_vecCellPercentDeviation,R1_vecCell,S*P),...
            'Percent deviation for R1_vecCell must contain a number of vertically concatenated elements equal to the number of cell models. Each element must be a scalar or equal to the size of the underlying parameter.');
        assert(isValidPercentDeviationSize(tau1_vecCellPercentDeviation,tau1_vecCell,S*P),...
            'Percent deviation for tau1_vecCell must contain a number of vertically concatenated elements equal to the number of cell models. Each element must be a scalar or equal to the size of the underlying parameter.');
    end

    connections
        connect(p,PA(1).p);
        connect(n,PA(end).n);
    end

    annotations
        [p] : Side=top;
        [n] : Side=bottom;
        UILayout = [UIGroup("Main",SOC_vecCell,SOC_vecCellPercentDeviation,V0_vecCell,V0_vecCellPercentDeviation,V_rangeCell,V_rangeCellPercentDeviation,R0_vecCell,R0_vecCellPercentDeviation,AHCell,AHCellPercentDeviation,extrapolation_optionCell),...
            UIGroup("Dynamics",R1_vecCell,R1_vecCellPercentDeviation,tau1_vecCell,tau1_vecCellPercentDeviation)];
        Icon = 'module.svg';
    end

    for Sidx = 1:S
        components(ExternalAccess=observe,CompileReuse=true)
            PA(Sidx) = P45BPack.ParallelAssemblies.ParallelAssemblyType1(P = P,...
                SOC_vecCell = SOC_vecCell,V0_vecCell = V0_vecCell,V_rangeCell = V_rangeCell,...
                R0_vecCell = R0_vecCell,AHCell = AHCell,...
                extrapolation_optionCell = extrapolation_optionCell,R1_vecCell = R1_vecCell,tau1_vecCell = tau1_vecCell,...
                SOC_vecCellPercentDeviation = indexParameterDeviation(SOC_vecCellPercentDeviation,S,Sidx),...
                V0_vecCellPercentDeviation = indexParameterDeviation(V0_vecCellPercentDeviation,S,Sidx),...
                V_rangeCellPercentDeviation = indexParameterDeviation(V_rangeCellPercentDeviation,S,Sidx),...
                R0_vecCellPercentDeviation = indexParameterDeviation(R0_vecCellPercentDeviation,S,Sidx),...
                AHCellPercentDeviation = indexParameterDeviation(AHCellPercentDeviation,S,Sidx),...
                R1_vecCellPercentDeviation = indexParameterDeviation(R1_vecCellPercentDeviation,S,Sidx),...
                tau1_vecCellPercentDeviation = indexParameterDeviation(tau1_vecCellPercentDeviation,S,Sidx),...
                iCell.priority = priority.none,vCell.priority = priority.none,socCell.priority = priority.none,...
                numCyclesCell.priority = priority.none,...
                vParallelAssembly.priority = priority.none,socParallelAssembly.priority = priority.none);
        end
    end

    for Sidx = 1:S-1
        connections
            connect(PA(Sidx).n,PA(Sidx+1).p);
        end
    end

    for Sidx = 1:S
        equations
            PA(Sidx).iCell == reshape(iCell((Sidx*P-(P-1)):(Sidx*P)),P,1);
            PA(Sidx).vCell == reshape(vCell((Sidx*P-(P-1)):(Sidx*P)),P,1);
            PA(Sidx).socCell == reshape(socCell((Sidx*P-(P-1)):(Sidx*P)),P,1);
            PA(Sidx).numCyclesCell == reshape(numCyclesCell((Sidx*P-(P-1)):(Sidx*P)),P,1);
            PA(Sidx).vParallelAssembly == vParallelAssembly(Sidx);
            PA(Sidx).socParallelAssembly == socParallelAssembly(Sidx);
        end
    end
end

function indexedParameterDeviation = indexParameterDeviation(parameterDeviation,s,sIndex)
    definitions
        parameterDeviationSize=size(parameterDeviation);
        moduleParameterDeviation=parameterDeviation(parameterDeviationSize(1) / s * (sIndex - 1) + 1 : parameterDeviationSize(1) / s * sIndex,:);
        indexedParameterDeviation=reshape(moduleParameterDeviation,[parameterDeviationSize(1) / s, parameterDeviationSize(2:end)]);
    end
end

function isValidSize = isValidPercentDeviationSize(percentDeviation,parameter,totalNumModels)
    definitions
        percentDeviationSize=size(percentDeviation);
        parameterSize=size(parameter);
        isScalarPercentDeviation=isequal(percentDeviationSize,[totalNumModels,1]);
        isTrueToSizePercentDeviation=isequal(percentDeviationSize,[parameterSize(1) * totalNumModels,parameterSize(2:end)]);
        isValidSize=isScalarPercentDeviation||isTrueToSizePercentDeviation;
    end
end