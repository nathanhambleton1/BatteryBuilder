+ (min(7, V(BAT,VSS)-1.75) - V(FUSE,VSS))/1k : 0

* ---- FET control logic ----
Bcfo cfo 0 V = (({CFETOFF_MODE})==1 && V(CFETOFF,VSS)>0.9) || (({CFETOFF_MODE})==2 && V(CFETOFF,VSS)<0.9)
+ || (({DFETOFF_MODE})==3 && V(DFETOFF,VSS)>0.9) || (({DFETOFF_MODE})==4 && V(DFETOFF,VSS)<0.9)
Bdfo dfo 0 V = (({DFETOFF_MODE})==1 && V(DFETOFF,VSS)>0.9) || (({DFETOFF_MODE})==2 && V(DFETOFF,VSS)<0.9)
+ || (({DFETOFF_MODE})==3 && V(DFETOFF,VSS)>0.9) || (({DFETOFF_MODE})==4 && V(DFETOFF,VSS)<0.9)
Bchf chg_flt 0 V = V(f_cov)>0.5 || V(f_occ)>0.5 || V(f_otc)>0.5 || V(f_utc)>0.5 || V(f_pf)>0.5
Bdsf dsg_flt 0 V = V(f_cuv)>0.5 || V(f_ocd1)>0.5 || V(f_ocd2)>0.5 || V(f_ocd3)>0.5
+ || V(f_scd)>0.5 || V(f_otd)>0.5 || V(f_utd)>0.5 || V(f_pf)>0.5
Bchok chg_ok 0 V = V(rdy)>0.5 && ({FET_EN})>0.5 && V(chg_flt)<0.5 && V(cfo)<0.5
Bdsok dsg_ok 0 V = V(rdy)>0.5 && ({FET_EN})>0.5 && V(dsg_flt)<0.5 && V(dfo)<0.5
* precharge mode
Bpc_s pc_s 0 V = ({PCHG_EN})>0.5 && V(vmin) < ({PCHG_START})
Bpc_r pc_r 0 V = V(vmin) > ({PCHG_STOP})
Xpcm pc_s pc_r nact pcm BQ76952_SR
Bchm chg_m 0 V = V(chg_ok)>0.5 && V(pcm)<0.5
Bpcc pchg_c 0 V = V(chg_ok)>0.5 && V(pcm)>0.5
* predischarge
Xpdt dsg_ok pd_t BQ76952_DLY TD={PDSG_TO}
Bdsm dsg_m 0 V = V(dsg_ok)>0.5 && (({PDSG_EN})<0.5 || V(pd_t)>0.5 || V(VC16,LD) < ({PDSG_DELTA}))
Bpdc pdsg_c 0 V = V(dsg_ok)>0.5 && ({PDSG_EN})>0.5 && V(dsg_m)<0.5
* body-diode protection (series FETs)
Bchc chg_c 0 V = V(chg_m)>0.5 || (({SERIES})>0.5 && V(rdy)>0.5 && V(f_pf)<0.5 && V(dsg_m)>0.5 && V(isns) < ({-BD_TH}))
Bdsc dsg_c 0 V = V(dsg_m)>0.5 || (({SERIES})>0.5 && V(rdy)>0.5 && V(f_pf)<0.5 && (V(chg_m)>0.5 || V(pchg_c)>0.5) && V(isns) > ({BD_TH}))
* 1 us smoothing of driver commands
Rchs chg_c chg_s 1k
Cchs chg_s 0 1n
Rdss dsg_c dsg_s 1k
Cdss dsg_s 0 1n
Rpcs pchg_c pchg_s 1k
Cpcs pchg_s 0 1n
Rpds pdsg_c pdsg_s 1k
Cpds pdsg_s 0 1n

* ---- charge pump (CP1 cap to BAT) and high-side NFET drivers ----
Bcpe cpe 0 V = V(act)>0.5 && ({CP_EN})>0.5
Bcp  BAT CP1 I = V(cpe)>0.5 ? min(100u, max(0, (({VCP}) - V(CP1,BAT))/10k)) : V(BAT,CP1)/1Meg
Bchon  CP1 CHG I = min(1, max(0, V(chg_s)))*min(100, max(-100, V(CP1,CHG)))*0.5*(1+tanh(min(50, max(-50, V(CP1,CHG)/0.05))))/200
Bchoff CHG BAT I = (1-min(1, max(0, V(chg_s))))*min(100, max(-100, V(CHG,BAT)))/1k
Bdson  CP1 DSG I = min(1, max(0, V(dsg_s)))*min(100, max(-100, V(CP1,DSG)))*0.5*(1+tanh(min(50, max(-50, V(CP1,DSG)/0.05))))/200
* DSG turn-off: sink to VSS, regulated so DSG stops at the LD (PACK+) level
Bdsoff DSG VSS I = (1-min(1, max(0, V(dsg_s))))*min(50, max(-1, V(DSG,LD)))*0.5*(1+tanh(min(50, max(-50, V(DSG,LD)/0.3))))/50
* PCHG / PDSG PFET drivers: sink up to 30 uA toward max(PACK,BAT)-8.4 V
Bpchg PCHG VSS I = V(pchg_s)>0.5 ? min(30u, max(0, 1e-4*(V(PCHG,VSS) - max(0, max(V(PACK,VSS),V(BAT,VSS))-8.4)))) : 0
Bpdsg PDSG VSS I = V(pdsg_s)>0.5 ? min(30u, max(0, 1e-4*(V(PDSG,VSS) - max(0, max(V(LD,VSS),V(BAT,VSS))-8.4)))) : 0

* ---- digital outputs ----
Bany any_f 0 V = V(chg_flt)>0.5 || V(dsg_flt)>0.5
Balrt ALERT VSS I = (({ALERT_EN})>0.5 && V(any_f)>0.5 && V(act)>0.5) ? V(ALERT,VSS)/100 : 0
Bvh  vh 0 V = V(act)>0.5 ? (({REG1_V})>0 ? V(REG1,VSS) : V(REG18,VSS)) : 0
Bddsg VSS DDSG I = ({DDSG_EN})>0.5 ? ((V(dsg_flt)>0.5 ? V(vh) : 0) - V(DDSG,VSS))/100 : 0
Bdchg VSS DCHG I = ({DCHG_EN})>0.5 ? ((V(chg_flt)>0.5 ? V(vh) : 0) - V(DCHG,VSS))/100 : 0

* ---- autonomous cell balancing ----
Bcba cb_ok 0 V = V(act)>0.5 && ({CB_EN})>0.5 && V(isns) > ({-CB_IDSG})
Bcbn cb_n 0 V = V(cb_ok) < 0.5
Bbs1 bs1 0 V = V(cb_ok)>0.5 && ({CE1})>0.5 && V(cm1) > ({CB_MINV}) && V(cm1)-V(vmin) > ({CB_START})
Bbr1 br1 0 V = V(cm1)-V(vmin) < ({CB_STOP})
Xb1 bs1 br1 cb_n b1 BQ76952_SR
Bgc1 gc1 0 V = V(b1)>0.5 && V(wb)>0.9 && V(mwin)<0.5 && V(cbph)<0.5
Cg1 g1 0 1n
Bg1 0 g1 I = 1n*((V(gc1)-V(g1)) > 0 ? (V(gc1)-V(g1))/200u : (V(gc1)-V(g1))/20u)
Bcb1 VC1 VC0 I = min(1, max(0, V(g1)))*V(VC1,VC0)/({RCB})
Bbs2 bs2 0 V = V(cb_ok)>0.5 && ({CE2})>0.5 && V(cm2) > ({CB_MINV}) && V(cm2)-V(vmin) > ({CB_START})
Bbr2 br2 0 V = V(cm2)-V(vmin) < ({CB_STOP})
Xb2 bs2 br2 cb_n b2 BQ76952_SR
Bgc2 gc2 0 V = V(b2)>0.5 && V(wb)>0.9 && V(mwin)<0.5 && V(cbph)>0.5
Cg2 g2 0 1n
Bg2 0 g2 I = 1n*((V(gc2)-V(g2)) > 0 ? (V(gc2)-V(g2))/200u : (V(gc2)-V(g2))/20u)
Bcb2 VC2 VC1 I = min(1, max(0, V(g2)))*V(VC2,VC1)/({RCB})
Bbs3 bs3 0 V = V(cb_ok)>0.5 && ({CE3})>0.5 && V(cm3) > ({CB_MINV}) && V(cm3)-V(vmin) > ({CB_START})
Bbr3 br3 0 V = V(cm3)-V(vmin) < ({CB_STOP})
Xb3 bs3 br3 cb_n b3 BQ76952_SR
Bgc3 gc3 0 V = V(b3)>0.5 && V(wb)>0.9 && V(mwin)<0.5 && V(cbph)<0.5
Cg3 g3 0 1n
Bg3 0 g3 I = 1n*((V(gc3)-V(g3)) > 0 ? (V(gc3)-V(g3))/200u : (V(gc3)-V(g3))/20u)
Bcb3 VC3 VC2 I = min(1, max(0, V(g3)))*V(VC3,VC2)/({RCB})
Bbs4 bs4 0 V = V(cb_ok)>0.5 && ({CE4})>0.5 && V(cm4) > ({CB_MINV}) && V(cm4)-V(vmin) > ({CB_START})
Bbr4 br4 0 V = V(cm4)-V(vmin) < ({CB_STOP})
