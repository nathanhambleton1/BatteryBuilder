* ---- dashboard probe nets (global; see header) ----
* discharged / charged Ah as the IC measures them (both count up)
Cccd ccd 0 1u
Bccd 0 ccd I = time > 0 ? 1u*V(act)*max(0, -((({CC_GAIN}))*V(SRP,SRN) + (({CC_OFFSET}))))/(({RSENSE}))/3600 : -1u*V(ccd)
Cccc ccc 0 1u
Bccc 0 ccc I = time > 0 ? 1u*V(act)*max(0, ((({CC_GAIN}))*V(SRP,SRN) + (({CC_OFFSET}))))/(({RSENSE}))/3600 : -1u*V(ccc)
Bd_ah  d_ah 0 V = 10*V(ccd)
Rd_ah  d_ah BMS_AH_DIS_X10 1k
Bd_ac  d_ac 0 V = 10*V(ccc)
Rd_ac  d_ac BMS_AH_CHG_X10 1k
Bd_vx  d_vx 0 V = 10*V(vmax)
Rd_vx  d_vx CELL_MAX_X10 1k
Bd_vn  d_vn 0 V = 10*V(vmin)
Rd_vn  d_vn CELL_MIN_X10 1k
Bd_sp  d_sp 0 V = 1000*(V(vmax) - V(vmin))
Rd_sp  d_sp CELL_SPREAD_MV 1k
Bd_ft  d_ft 0 V = max(max(max(10*(V(f_cov)>0.5), 20*(V(f_cuv)>0.5)), max(30*(V(f_occ)>0.5),
+ 40*(V(f_ocd1)>0.5 || V(f_ocd2)>0.5 || V(f_ocd3)>0.5))), max(max(50*(V(f_scd)>0.5),
+ 60*(V(f_otc)>0.5 || V(f_otd)>0.5 || V(f_utc)>0.5 || V(f_utd)>0.5)), 70*(V(f_pf)>0.5)))
Rd_ft  d_ft BMS_FAULT 1k
Bd_fe  d_fe 0 V = 10*(V(chg_s)>0.5) + 5*(V(dsg_s)>0.5)
Rd_fe  d_fe BMS_FETS 1k
* host-interlock signals (like the DDSG/DCHG pins, active high = OK)
Bd_dk  d_dk 0 V = V(rdy)>0.5 && V(dsg_flt)<0.5
Rd_dk  d_dk BMS_DSG_OK 1k
Bd_ck  d_ck 0 V = V(rdy)>0.5 && V(chg_flt)<0.5
Rd_ck  d_ck BMS_CHG_OK 1k
Bd_cb  d_cb 0 V = (V(b1)>0.5) + (V(b2)>0.5) + (V(b3)>0.5) + (V(b4)>0.5) + (V(b5)>0.5) + (V(b6)>0.5) + (V(b7)>0.5) + (V(b8)>0.5) + (V(b9)>0.5) + (V(b10)>0.5) + (V(b11)>0.5) + (V(b12)>0.5) + (V(b13)>0.5) + (V(b14)>0.5) + (V(b15)>0.5) + (V(b16)>0.5)
