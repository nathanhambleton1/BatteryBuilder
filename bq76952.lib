* ============================================================================
*  BQ76952  3S-16S Li-ion battery monitor & protector - BEHAVIORAL MODEL
*  Target: ngspice (KiCad 7/8/9 built-in simulator). Plain SPICE + B-sources,
*  no XSPICE code models. Tested with ngspice-42 (all compatibility modes).
*  Built from TI datasheet SLUSE13B (Nov 2021). NOT a TI model.
*
*  Subcircuit pins are in PHYSICAL PIN ORDER 1..48 (TQFP-48 PFB), so a
*  KiCad symbol whose pin numbers match the datasheet maps 1:1.
*
*  MODELED
*   - 16 differential cell inputs (VCn - VCn-1), 2.1 Mohm load, inter-pin
*     ESD diodes, per-cell enable (CEn)
*   - Comparator protections: COV, CUV, OCC, OCD1, OCD2, OCD3, SCD with
*     programmable thresholds/delays and autonomous recovery
*   - Thermistor protections OTC/OTD/UTC/UTD on TS1..TS3 (18k pull-up to
*     REG18, beta-model NTC)
*   - Permanent fail: SOV/SUV, FUSE drive and FUSE sense
*   - Charge pump on CP1 (BAT+11 V or BAT+5.5 V, current limited)
*   - High-side NFET drivers CHG (turn-off to BAT) and DSG (turn-off to LD)
*   - Series-FET body-diode protection, PCHG/PDSG PFET drivers,
*     precharge / predischarge modes
*   - CFETOFF / DFETOFF / BOTHOFF pins, RST_SHUT (1 s -> SHUTDOWN),
*     wake on TS2 low or LD high, BAT POR with hysteresis, startup delay
*   - REG18, REG0 pre-regulator (BREG drives external NPN, REGIN ~5.5 V),
*     REG1/REG2 LDOs (45 mA, ~60 mA current limit)
*   - ALERT (open drain, low on any fault), DDSG/DCHG fault outputs
*   - Autonomous cell balancing (28 ohm internal FETs, start/stop delta),
*     paused for a 3 ms sampling window every CB_TS like the real IC;
*     protections use the sampled (unloaded) cell voltages while balancing
*  NOT MODELED
*   - I2C / SPI / HDQ (SCL, SDA, HDQ are high-Z), OTP/registers, ADC
*     quantisation & measurement-loop timing, SLEEP/DEEPSLEEP, open-wire
*     check, OCDL/SCDL latches & load-detect recovery, watchdog, FET
*     source-follower mode, DSG pulsed turn-off waveform (approximated by
*     a 50 ohm sink to VSS that stops at the LD level), balancing
*     adjacency/max-cell limits, temperature drift / accuracy spreads.
*
*  Settings are instance parameters (KiCad: Sim.Params), SI units:
*  volts, amps, seconds, degC. Current-based protection thresholds are
*  sense-resistor VOLTAGES, exactly like the IC (68m = 68 mV = 68 A @ 1 mOhm).
*  DEFAULTS ARE TUNED FOR A 16S1P MOLICEL P45B PACK WITH A 1 mOhm SENSE
*  RESISTOR (4.20 V / 2.50 V cells, 45 A continuous, 13.5 A max charge).
*  The datasheet Table 16-1 example values are listed as [TI ex. ...].
*
*  Useful internal nodes to plot (prefix with the instance, e.g. XU1.):
*   cv1..cv16 cell voltages, vmax, vmin, isns (A, + = charge), t1..t3 (degC)
*   ccq = accumulated charge, Ah (+ = charge)
*  PROBE NETS (global, no pin needed - add a global label + SIM_PROBE):
*   BMS_AH_OUT  Ah the IC has counted out of the pack (1 V = 1 Ah)
*   BMS_SOC     host-style SOC = BMS_SOC0 + 100*ccq/BMS_CAP_AH (1 V = 1 %)
*   (the BQ76952 itself only reports accumulated charge; SOC is what the
*    host MCU would compute from it)
*   BMS_AH_DIS_X10  10 x Ah the IC counted out of the pack (counts up only)
*   BMS_AH_CHG_X10  10 x Ah the IC counted into the pack (counts up only)
*   CELL_MAX_X10    10 x highest cell voltage the IC sees (42 = 4.2 V)
*   CELL_MIN_X10    10 x lowest cell voltage
*   CELL_SPREAD_MV  highest - lowest cell, mV
*   BMS_FAULT       highest active fault: 10 COV, 20 CUV, 30 OCC,
*                   40 OCD1/2/3, 50 SCD, 60 OT/UT, 70 PF, 0 none
*   BMS_FETS        10 = CHG driver on, + 5 = DSG driver on (15 = both)
*   BMS_DSG_OK / BMS_CHG_OK  1 = discharge / charge allowed (no fault);
*                   used by LOAD_PROFILE INTERLOCK=1 (host reacting to the BMS)
*   BMS_BALANCING   number of cells selected for balancing (odd and even
*                   cells conduct in alternate CB_TS intervals)
*   f_cov f_cuv f_occ f_ocd1 f_ocd2 f_ocd3 f_scd f_otc f_otd f_utc f_utd f_pf
*   rdy shut chg_ok dsg_ok chg_s dsg_s pchg_s pdsg_s b1..b16 (balancing)
*  All internal logic nodes are 0/1 V referenced to node 0.
* ============================================================================

.global BMS_DSG_OK BMS_CHG_OK BMS_AH_OUT BMS_SOC BMS_AH_DIS_X10 BMS_AH_CHG_X10 CELL_MAX_X10 CELL_MIN_X10 CELL_SPREAD_MV BMS_FAULT BMS_FETS BMS_BALANCING

*  PARAMETERS
*   CE1..CE16     1       cell n enabled (1) / unused-shorted input (0)
*   RSENSE        1m      sense resistor value, ohm (used for A-based settings)
*   OV_TH         4.25    COV threshold, V (50.6 mV steps; 4.2504 = 84 steps) [TI ex. 4.30]
*   OV_DLY        0.5     COV delay, s (3.3 ms steps)
*   OV_HYS        0.1     COV recovery hysteresis, V
*   UV_TH         2.53    CUV threshold, V (2.53 = 50 steps, P45B cut-off 2.5) [TI ex. 2.50]
*   UV_DLY        1       CUV delay, s (rides through high-rate sag) [TI ex. 20m]
*   UV_HYS        0.1     CUV recovery hysteresis, V
*   OCC_TH        14m     OCC threshold, V across RSENSE (P45B max charge 13.5 A) [TI ex. 8m]
*   OCC_DLY       160m    OCC delay, s
*   OCC_REC       -0.2    OCC recovers when I < OCC_REC (A) for REC_TIME
*   OCD1_TH       100m    OCD1 threshold, V (4-200 mV) [TI ex. 68m]
*   OCD1_DLY      20m     OCD1 delay, s [TI ex. 10m]
*   OCD2_TH       70m     OCD2 threshold, V [TI ex. 56m]
*   OCD2_DLY      200m    OCD2 delay, s (max 425 ms) [TI ex. 80m]
*   OCD3_TH       50m     OCD3 threshold, V (P45B 45 A cont.) (0 = off) [TI ex. 28m]
*   OCD3_DLY      2       OCD3 delay, s [TI ex. 160m]
*   OCD_REC       0.2     OCDx recovers when I > OCD_REC (A) for REC_TIME
*   SCD_TH        150m    SCD threshold, V (10..500 mV list) [TI ex. 80m]
*   SCD_DLY       90u     SCD delay, s (15 us steps) [TI ex. 50u]
*   SCD_REC       5       SCD recovery time, s
*   REC_TIME      3       generic protection recovery time, s
*   TS1_EN        0       TS1 thermistor measurement enabled
*   TS2_EN        0       TS2 thermistor measurement enabled
*   TS3_EN        0       TS3 thermistor measurement enabled
*   TS_R25        10k     thermistor R25, ohm
*   TS_BETA       3435    thermistor beta, K (Semitec 103AT)
*   OT_EN         1       OTC/OTD enabled
*   UT_EN         1       UTC/UTD enabled
*   OTC_TH        55      degC (P45B charge max 60) [TI ex. 45]
*   OTC_DLY       2       s
*   OTD_TH        60      degC (P45B discharge max 60)
*   OTD_DLY       2       s
*   UTC_TH        0       degC
*   UTC_DLY       5       s
*   UTD_TH        -20     degC
*   UTD_DLY       10      s
*   T_HYS         5       temperature recovery hysteresis, degC
*   SOV_TH        0       safety cell OV PF threshold, V (0 = disabled)
*   SOV_DLY       5       s
*   SUV_TH        0       safety cell UV PF threshold, V (0 = disabled)
*   SUV_DLY       5       s
*   FUSE_BLOW     0       1 = drive FUSE pin on PF
*   FUSE_PF_EN    0       1 = FUSE pin driven high externally causes PF
*   FET_EN        1       1 = autonomous FET control (0 = FETs held off)
*   SERIES        1       1 = series CHG/DSG FETs (body-diode protection on)
*   BD_TH         50m     body-diode protection current threshold, A
*   CP_EN         1       charge pump enabled
*   VCP           11      charge pump overdrive, V (11 or 5.5)
*   PCHG_EN       0       precharge mode enabled
*   PCHG_START    3.0     min cell below this -> charge through PCHG, V
*   PCHG_STOP     3.2     min cell above this -> leave precharge, V
*   PDSG_EN       0       predischarge enabled
*   PDSG_TO       0.5     predischarge timeout, s
*   PDSG_DELTA    0.5     predischarge ends when VC16-LD < this, V
*   CFETOFF_MODE  0       0 off, 1 active-high, 2 active-low
*   DFETOFF_MODE  0       0 off, 1/2 DFETOFF hi/lo, 3/4 BOTHOFF hi/lo
*   REG0_EN       1       REG0 pre-regulator (BREG/REGIN 5.5 V) enabled
*   REG1_V        3.3     REG1 output, V (0 = off)
*   REG2_V        0       REG2 output, V (0 = off)
*   CB_EN         0       autonomous cell balancing enabled
*   CB_START      40m     balance start delta (cell - min cell), V
*   CB_STOP       20m     balance stop delta, V
*   CB_MINV       3.9     minimum cell voltage to balance, V
*   CB_IDSG       50m     no balancing while discharging above this, A
*   RCB           28      internal balance FET resistance, ohm
*   CB_TS         5       balancing interval: FETs paused 50 ms for sampling, s
*   TSTART        0.28    wake -> FETs enabled delay, s
*   VPOR          3.5     BAT power-on reset threshold, V
*   IQ            286u    NORMAL mode BAT current, A
*   RCIN          2.1Meg  effective differential cell input resistance
*   CC_GAIN       1       coulomb-counter gain (1 = calibrated; 1.01 = +1 % error)
*   CC_OFFSET     0       coulomb-counter input offset, V (datasheet <~1 uV)
*   BMS_SOC0      100     host SOC estimate at t = 0, %
*   BMS_CAP_AH    4.5     capacity the host divides by, Ah
*   DDSG_EN       1       DDSG pin = DSG-fault logic output
*   DCHG_EN       1       DCHG pin = CHG-fault logic output
*   ALERT_EN      1       ALERT pin = open-drain, low on any fault
* ============================================================================

* ---- delay: out = in, but only after in has been high for TD seconds -------
.subckt BQ76952_DLY in out params: TD=1
Ct  t 0 1u
Bt  0 t I = V(in)>0.5 ? min(1u, 1u*(({2*TD}) - V(t))/({0.01*TD+1n})) : -1*min(1e6, max(-1e6, V(t)))
Bo  out 0 V = (V(in)>0.5) * 0.5*(1+tanh(min(50, max(-50, (V(t) - ({0.999*TD}))/({0.0003*TD+1n})))))
.ends BQ76952_DLY

* ---- set/reset latch with clear (clr > set > reset > hold); inputs 0..1 ---
.subckt BQ76952_SR s r clr q
Cq  q 0 1n
* inputs/state are clamped so a wild Newton iterate cannot overflow the products
Bql qc 0 V = min(2, max(-1, V(q)))
Bsl sc 0 V = min(1, max(0, V(s)))
Brl rc 0 V = min(1, max(0, V(r)))
Bcl cc 0 V = min(1, max(0, V(clr)))
Bq  0 q I = 1e-2*( (1-V(cc))*( V(sc)*(1-V(qc)) - (1-V(sc))*V(rc)*V(qc) ) - V(cc)*V(qc) )
+ + 1e-9*( 0.5*(1+tanh(20*(V(qc)-0.5))) - V(qc) )
.ends BQ76952_SR

* ---- transconductance LDO with current limit and off-state pull-down -------
.subckt BQ76952_LDO in out vss en params: VSET=3.3 ILIM=60m GM=5 VDO=0.5 RPD=2.5k
* en is a smoothed 0..1 signal; output current is scaled by it
Bp  in out I = V(in,out)>0 ?
+ V(en)*min(({ILIM}), max(0, ({GM})*(min(({VSET}), V(in,vss)-({VDO})) - V(out,vss)))) : 0
Bpd out vss I = (1-V(en))*V(out,vss)/({RPD})
.ends BQ76952_LDO

.subckt BQ76952 VC15 VC14 VC13 VC12 VC11 VC10 VC9 VC8 VC7 VC6 VC5 VC4 VC3
+ VC2 VC1 VC0 VSS SRP NC19 SRN TS1 TS2 TS3 REG18 ALERT SCL SDA HDQ CFETOFF
+ DFETOFF DCHG DDSG RST_SHUT REG2 REG1 REGIN BREG FUSE PDSG PCHG LD PACK DSG
+ NC44 CHG CP1 BAT VC16
+ params: CE1=1 CE2=1 CE3=1 CE4=1 CE5=1 CE6=1 CE7=1 CE8=1 CE9=1 CE10=1
+ CE11=1 CE12=1 CE13=1 CE14=1 CE15=1 CE16=1 RSENSE=1m OV_TH=4.25 OV_DLY=0.5
+ OV_HYS=0.1 UV_TH=2.53 UV_DLY=1 UV_HYS=0.1 OCC_TH=14m OCC_DLY=160m
+ OCC_REC=-0.2 OCD1_TH=100m OCD1_DLY=20m OCD2_TH=70m OCD2_DLY=200m
+ OCD3_TH=50m OCD3_DLY=2 OCD_REC=0.2 SCD_TH=150m SCD_DLY=90u SCD_REC=5
+ REC_TIME=3 TS1_EN=0 TS2_EN=0 TS3_EN=0 TS_R25=10k TS_BETA=3435 OT_EN=1
+ UT_EN=1 OTC_TH=55 OTC_DLY=2 OTD_TH=60 OTD_DLY=2 UTC_TH=0 UTC_DLY=5
+ UTD_TH=-20 UTD_DLY=10 T_HYS=5 SOV_TH=0 SOV_DLY=5 SUV_TH=0 SUV_DLY=5
+ FUSE_BLOW=0 FUSE_PF_EN=0 FET_EN=1 SERIES=1 BD_TH=50m CP_EN=1 VCP=11
+ PCHG_EN=0 PCHG_START=3.0 PCHG_STOP=3.2 PDSG_EN=0 PDSG_TO=0.5
+ PDSG_DELTA=0.5 CFETOFF_MODE=0 DFETOFF_MODE=0 REG0_EN=1 REG1_V=3.3 REG2_V=0
+ CB_EN=0 CB_START=40m CB_STOP=20m CB_MINV=3.9 CB_IDSG=50m RCB=28 CB_TS=5
+ TSTART=0.28 VPOR=3.5 IQ=286u RCIN=2.1Meg CC_GAIN=1 CC_OFFSET=0
+ BMS_SOC0=100 BMS_CAP_AH=4.5 DDSG_EN=1 DCHG_EN=1 ALERT_EN=1

* ---- pin leakage / DC paths (keeps unconnected pins solvable) ----
Rlk_VC15 VC15 VSS 1G
Rlk_VC14 VC14 VSS 1G
Rlk_VC13 VC13 VSS 1G
Rlk_VC12 VC12 VSS 1G
Rlk_VC11 VC11 VSS 1G
Rlk_VC10 VC10 VSS 1G
Rlk_VC9 VC9 VSS 1G
Rlk_VC8 VC8 VSS 1G
Rlk_VC7 VC7 VSS 1G
Rlk_VC6 VC6 VSS 1G
Rlk_VC5 VC5 VSS 1G
Rlk_VC4 VC4 VSS 1G
Rlk_VC3 VC3 VSS 1G
Rlk_VC2 VC2 VSS 1G
Rlk_VC1 VC1 VSS 1G
Rlk_VC0 VC0 VSS 1G
Rlk_SRP SRP VSS 1G
Rlk_NC19 NC19 VSS 1G
Rlk_SRN SRN VSS 1G
Rlk_TS1 TS1 VSS 1G
Rlk_TS2 TS2 VSS 1G
Rlk_TS3 TS3 VSS 1G
Rlk_REG18 REG18 VSS 1G
Rlk_ALERT ALERT VSS 1G
Rlk_SCL SCL VSS 1G
Rlk_SDA SDA VSS 1G
Rlk_HDQ HDQ VSS 1G
Rlk_CFETOFF CFETOFF VSS 1G
Rlk_DFETOFF DFETOFF VSS 1G
Rlk_DCHG DCHG VSS 1G
Rlk_DDSG DDSG VSS 1G
Rlk_RST_SHUT RST_SHUT VSS 1G
Rlk_REG2 REG2 VSS 1G
Rlk_REG1 REG1 VSS 1G
Rlk_REGIN REGIN VSS 1G
Rlk_BREG BREG VSS 1G
Rlk_FUSE FUSE VSS 1G
Rlk_PDSG PDSG VSS 1G
Rlk_PCHG PCHG VSS 1G
Rlk_LD LD VSS 1G
Rlk_PACK PACK VSS 1G
Rlk_DSG DSG VSS 1G
Rlk_NC44 NC44 VSS 1G
Rlk_CHG CHG VSS 1G
Rlk_CP1 CP1 VSS 1G
Rlk_BAT BAT VSS 1G
Rlk_VC16 VC16 VSS 1G
Rsns SRP SRN 2Meg
Rld  LD VSS 2Meg
Rpk  PACK VSS 10Meg
* pin capacitances (also keep the driver nodes well-conditioned numerically)
Cpin_CHG CHG VSS 10p
Cpin_DSG DSG VSS 10p
Cpin_PCHG PCHG VSS 10p
Cpin_PDSG PDSG VSS 10p
Cpin_LD LD VSS 10p
Cpin_PACK PACK VSS 10p
Cpin_BREG BREG VSS 10p
Cpin_FUSE FUSE VSS 10p
Cpin_ALERT ALERT VSS 10p
Cpin_DDSG DDSG VSS 10p
Cpin_DCHG DCHG VSS 10p

* ---- cell inputs ----
.model BQ_DESD D(IS=1e-15 N=1 RS=10)
.model BQ_DREG D(IS=1e-14 N=1)
Rcin1 VC1 VC0 {RCIN}
Desd1 VC0 VC1 BQ_DESD
Bcv1 cv1 0 V = V(VC1,VC0)
Rcin2 VC2 VC1 {RCIN}
Desd2 VC1 VC2 BQ_DESD
Bcv2 cv2 0 V = V(VC2,VC1)
Rcin3 VC3 VC2 {RCIN}
Desd3 VC2 VC3 BQ_DESD
Bcv3 cv3 0 V = V(VC3,VC2)
Rcin4 VC4 VC3 {RCIN}
Desd4 VC3 VC4 BQ_DESD
Bcv4 cv4 0 V = V(VC4,VC3)
Rcin5 VC5 VC4 {RCIN}
Desd5 VC4 VC5 BQ_DESD
Bcv5 cv5 0 V = V(VC5,VC4)
Rcin6 VC6 VC5 {RCIN}
Desd6 VC5 VC6 BQ_DESD
Bcv6 cv6 0 V = V(VC6,VC5)
Rcin7 VC7 VC6 {RCIN}
Desd7 VC6 VC7 BQ_DESD
Bcv7 cv7 0 V = V(VC7,VC6)
Rcin8 VC8 VC7 {RCIN}
Desd8 VC7 VC8 BQ_DESD
Bcv8 cv8 0 V = V(VC8,VC7)
Rcin9 VC9 VC8 {RCIN}
Desd9 VC8 VC9 BQ_DESD
Bcv9 cv9 0 V = V(VC9,VC8)
Rcin10 VC10 VC9 {RCIN}
Desd10 VC9 VC10 BQ_DESD
Bcv10 cv10 0 V = V(VC10,VC9)
Rcin11 VC11 VC10 {RCIN}
Desd11 VC10 VC11 BQ_DESD
Bcv11 cv11 0 V = V(VC11,VC10)
Rcin12 VC12 VC11 {RCIN}
Desd12 VC11 VC12 BQ_DESD
Bcv12 cv12 0 V = V(VC12,VC11)
Rcin13 VC13 VC12 {RCIN}
Desd13 VC12 VC13 BQ_DESD
Bcv13 cv13 0 V = V(VC13,VC12)
Rcin14 VC14 VC13 {RCIN}
Desd14 VC13 VC14 BQ_DESD
Bcv14 cv14 0 V = V(VC14,VC13)
Rcin15 VC15 VC14 {RCIN}
Desd15 VC14 VC15 BQ_DESD
Bcv15 cv15 0 V = V(VC15,VC14)
Rcin16 VC16 VC15 {RCIN}
Desd16 VC15 VC16 BQ_DESD
Bcv16 cv16 0 V = V(VC16,VC15)
* balancing / measurement scheme (like the IC): every CB_TS the balancing
* FETs are paused for 50 ms and all cells are sampled mid-window. While any
* cell is balancing, protections and balancing decisions use those samples
* (the live pin voltages are distorted by the balance current); otherwise
* they use live values. Odd and even cells balance in alternate CB_TS
* intervals, so adjacent cells are never balanced at the same time.
Vmwin mwin_p 0 PULSE(0 1 {(1-CB_EN)*1e9} 1u 1u 50m {CB_TS})
Bmwin mwin 0 V = V(mwin_p)>0.5 || time <= 0
Vtrw trw_p 0 PULSE(0 1 {10m+(1-CB_EN)*1e9} 1u 1u 30m {CB_TS})
Btrk trkc 0 V = V(trw_p)>0.5 || V(wb)<0.5 || time <= 0
Rtrk trkc trk 10k
Ctrk trk 0 1n
Vcbph cbph 0 PULSE(0 1 {CB_TS+(1-CB_EN)*1e9} 1m 1m {CB_TS-1m} {2*CB_TS})
* hold weight: switches to the held samples within ~10 us when balancing
* starts (before the balance FETs ramp on, ~200 us) and back to live values
* only ~2 ms after it stops (after the FETs are fully off)
Bwbc wbc 0 V = V(cbany)>0.5
Cwb  wb 0 1n
Bwb  0 wb I = 1n*((V(wbc)-V(wb)) > 0 ? (V(wbc)-V(wb))/10u : (V(wbc)-V(wb))/2m)
Ch1 h1 0 1u
Bh1 0 h1 I = 1e-2*min(1, max(0, V(trk)))*(V(cv1)-V(h1))
Bcm1 cm1 0 V = V(wb)*V(h1) + (1-V(wb))*V(cv1)
Ch2 h2 0 1u
Bh2 0 h2 I = 1e-2*min(1, max(0, V(trk)))*(V(cv2)-V(h2))
Bcm2 cm2 0 V = V(wb)*V(h2) + (1-V(wb))*V(cv2)
Ch3 h3 0 1u
Bh3 0 h3 I = 1e-2*min(1, max(0, V(trk)))*(V(cv3)-V(h3))
Bcm3 cm3 0 V = V(wb)*V(h3) + (1-V(wb))*V(cv3)
Ch4 h4 0 1u
Bh4 0 h4 I = 1e-2*min(1, max(0, V(trk)))*(V(cv4)-V(h4))
Bcm4 cm4 0 V = V(wb)*V(h4) + (1-V(wb))*V(cv4)
Ch5 h5 0 1u
Bh5 0 h5 I = 1e-2*min(1, max(0, V(trk)))*(V(cv5)-V(h5))
Bcm5 cm5 0 V = V(wb)*V(h5) + (1-V(wb))*V(cv5)
Ch6 h6 0 1u
Bh6 0 h6 I = 1e-2*min(1, max(0, V(trk)))*(V(cv6)-V(h6))
Bcm6 cm6 0 V = V(wb)*V(h6) + (1-V(wb))*V(cv6)
Ch7 h7 0 1u
Bh7 0 h7 I = 1e-2*min(1, max(0, V(trk)))*(V(cv7)-V(h7))
Bcm7 cm7 0 V = V(wb)*V(h7) + (1-V(wb))*V(cv7)
Ch8 h8 0 1u
Bh8 0 h8 I = 1e-2*min(1, max(0, V(trk)))*(V(cv8)-V(h8))
Bcm8 cm8 0 V = V(wb)*V(h8) + (1-V(wb))*V(cv8)
Ch9 h9 0 1u
Bh9 0 h9 I = 1e-2*min(1, max(0, V(trk)))*(V(cv9)-V(h9))
Bcm9 cm9 0 V = V(wb)*V(h9) + (1-V(wb))*V(cv9)
Ch10 h10 0 1u
Bh10 0 h10 I = 1e-2*min(1, max(0, V(trk)))*(V(cv10)-V(h10))
Bcm10 cm10 0 V = V(wb)*V(h10) + (1-V(wb))*V(cv10)
Ch11 h11 0 1u
Bh11 0 h11 I = 1e-2*min(1, max(0, V(trk)))*(V(cv11)-V(h11))
Bcm11 cm11 0 V = V(wb)*V(h11) + (1-V(wb))*V(cv11)
Ch12 h12 0 1u
Bh12 0 h12 I = 1e-2*min(1, max(0, V(trk)))*(V(cv12)-V(h12))
Bcm12 cm12 0 V = V(wb)*V(h12) + (1-V(wb))*V(cv12)
Ch13 h13 0 1u
Bh13 0 h13 I = 1e-2*min(1, max(0, V(trk)))*(V(cv13)-V(h13))
Bcm13 cm13 0 V = V(wb)*V(h13) + (1-V(wb))*V(cv13)
Ch14 h14 0 1u
Bh14 0 h14 I = 1e-2*min(1, max(0, V(trk)))*(V(cv14)-V(h14))
Bcm14 cm14 0 V = V(wb)*V(h14) + (1-V(wb))*V(cv14)
Ch15 h15 0 1u
Bh15 0 h15 I = 1e-2*min(1, max(0, V(trk)))*(V(cv15)-V(h15))
Bcm15 cm15 0 V = V(wb)*V(h15) + (1-V(wb))*V(cv15)
Ch16 h16 0 1u
Bh16 0 h16 I = 1e-2*min(1, max(0, V(trk)))*(V(cv16)-V(h16))
Bcm16 cm16 0 V = V(wb)*V(h16) + (1-V(wb))*V(cv16)
Bvmax vmax 0 V = max((({CE16})>0.5 ? V(cm16) : -10), max((({CE15})>0.5 ? V(cm15) : -10), max((({CE14})>0.5 ? V(cm14) : -10), max((({CE13})>0.5 ? V(cm13) : -10), max((({CE12})>0.5 ? V(cm12) : -10), max((({CE11})>0.5 ? V(cm11) : -10), max((({CE10})>0.5 ? V(cm10) : -10), max((({CE9})>0.5 ? V(cm9) : -10), max((({CE8})>0.5 ? V(cm8) : -10), max((({CE7})>0.5 ? V(cm7) : -10), max((({CE6})>0.5 ? V(cm6) : -10), max((({CE5})>0.5 ? V(cm5) : -10), max((({CE4})>0.5 ? V(cm4) : -10), max((({CE3})>0.5 ? V(cm3) : -10), max((({CE2})>0.5 ? V(cm2) : -10), max((({CE1})>0.5 ? V(cm1) : -10), -10))))))))))))))))
Bvmin vmin 0 V = min((({CE16})>0.5 ? V(cm16) : 10), min((({CE15})>0.5 ? V(cm15) : 10), min((({CE14})>0.5 ? V(cm14) : 10), min((({CE13})>0.5 ? V(cm13) : 10), min((({CE12})>0.5 ? V(cm12) : 10), min((({CE11})>0.5 ? V(cm11) : 10), min((({CE10})>0.5 ? V(cm10) : 10), min((({CE9})>0.5 ? V(cm9) : 10), min((({CE8})>0.5 ? V(cm8) : 10), min((({CE7})>0.5 ? V(cm7) : 10), min((({CE6})>0.5 ? V(cm6) : 10), min((({CE5})>0.5 ? V(cm5) : 10), min((({CE4})>0.5 ? V(cm4) : 10), min((({CE3})>0.5 ? V(cm3) : 10), min((({CE2})>0.5 ? V(cm2) : 10), min((({CE1})>0.5 ? V(cm1) : 10), 10))))))))))))))))
Bisns isns 0 V = V(SRP,SRN)/({RSENSE})
* ---- coulomb counter: accumulated charge, Ah (+ = charge, like the IC's
*      PASSQ / "Accumulated Charge"). Integrates what the IC sees on SRP-SRN
*      using its programmed sense resistor (RSENSE), gain and offset.
Cccq ccq 0 1u
Bccq 0 ccq I = time > 0 ? 1u*V(act)*((({CC_GAIN}))*V(SRP,SRN) + (({CC_OFFSET})))/(({RSENSE}))/3600 : -1u*V(ccq)
* probe nets (global): Ah out (+ = discharge) and a host-style SOC estimate
Bbah bah 0 V = -V(ccq)
Rbah bah BMS_AH_OUT 1k
Bbsc bsc 0 V = min(100, max(0, (({BMS_SOC0})) + 100*V(ccq)/(({BMS_CAP_AH}))))
Rbsc bsc BMS_SOC 1k

* ---- power, reset, shutdown, startup ----
Bpor_s por_s 0 V = V(BAT,VSS) > ({VPOR})
Bpor_r por_r 0 V = V(BAT,VSS) < ({VPOR-0.18})
Vzero zero 0 0
Xpor por_s por_r zero pwr BQ76952_SR
Bnpwr npwr 0 V = V(pwr) < 0.5
Brst  rsth 0 V = V(pwr)>0.5 && V(RST_SHUT,VSS) > 0.9
Xrstd rsth sd_s BQ76952_DLY TD=1
Bwake wake 0 V = V(RST_SHUT,VSS) < 0.9 && (V(TS2,VSS) < 0.9 || V(LD,VSS) > 1.45)
Xshut sd_s wake npwr shut BQ76952_SR
Bact  act 0 V = V(pwr)>0.5 && V(shut)<0.5
Bnact nact 0 V = V(act) < 0.5
Xactd act act_d BQ76952_DLY TD={TSTART}
* startup window after t=0 (PWL source so ngspice gets a breakpoint)
Vtst  tst 0 PWL(0 0 {TSTART} 0 {TSTART+10u} 1)
Brdy  rdy 0 V = V(act_d)>0.5 && V(tst) > 0.5
* supply current
Biq   BAT VSS I = (V(act)>0.5 ? ({IQ}) : 1u) * min(1, max(0, V(BAT,VSS)/4))
* TS2 weak 5 V drive while in SHUTDOWN (wake circuit)
Bts2w VSS TS2 I = V(shut)>0.5 ? (min(5, V(BAT,VSS)) - V(TS2,VSS))/4.6Meg : 0

* ---- regulators ----
* smoothed (10 us) enables for the regulators
Racts act acts 10k
Cacts acts 0 1n
Xreg18 BAT REG18 VSS acts BQ76952_LDO VSET=1.8 ILIM=14m GM=1 VDO=1.0 RPD=10k
Bre0c re0c 0 V = V(act)>0.5 && ({REG0_EN})>0.5
Rre0  re0c re0 10k
Cre0  re0 0 1n
* REG0: proportional error amp (gain 10) driving the external NPN base;
* r0i = commanded BREG voltage (10 us pole, algebraic at DC)
Cr0   r0i 0 1n
Br0   0 r0i I = 1e-4*( V(re0)*min(max(0, V(BAT,VSS)-1.5), max(0, 6.15 + 10*(5.5 - V(REGIN,VSS)))) - V(r0i) )
Bbrs  BAT BREG I = V(re0)*min(3.33m, max(0, (V(r0i)-V(BREG,VSS))/1k))
Bbrk  BREG VSS I = V(re0)*min(1m, max(0, (V(BREG,VSS)-V(r0i))/1k))
Dregin REGIN BAT BQ_DREG
Bre1c re1c 0 V = V(act)>0.5 && ({REG1_V})>0
Rre1  re1c re1 10k
Cre1  re1 0 1n
Bre2c re2c 0 V = V(act)>0.5 && ({REG2_V})>0
Rre2  re2c re2 10k
Cre2  re2 0 1n
Xreg1 REGIN REG1 VSS re1 BQ76952_LDO VSET={REG1_V} ILIM=60m GM=5 VDO=0.5 RPD=2.5k
Xreg2 REGIN REG2 VSS re2 BQ76952_LDO VSET={REG2_V} ILIM=60m GM=5 VDO=0.5 RPD=2.5k

* ---- thermistors (18k pull-up from REG18 when enabled) ----
Bpu1 REG18 TS1 I = ({TS1_EN})>0.5 ? V(REG18,TS1)/18k : 0
Bt1 t1 0 V = 1/(1/298.15 + ln(max(1, 18k*max(1e-4,V(TS1,VSS))/max(1e-4, V(REG18,VSS)-V(TS1,VSS)))/({TS_R25}))/({TS_BETA})) - 273.15
Bpu2 REG18 TS2 I = ({TS2_EN})>0.5 ? V(REG18,TS2)/18k : 0
Bt2 t2 0 V = 1/(1/298.15 + ln(max(1, 18k*max(1e-4,V(TS2,VSS))/max(1e-4, V(REG18,VSS)-V(TS2,VSS)))/({TS_R25}))/({TS_BETA})) - 273.15
Bpu3 REG18 TS3 I = ({TS3_EN})>0.5 ? V(REG18,TS3)/18k : 0
Bt3 t3 0 V = 1/(1/298.15 + ln(max(1, 18k*max(1e-4,V(TS3,VSS))/max(1e-4, V(REG18,VSS)-V(TS3,VSS)))/({TS_R25}))/({TS_BETA})) - 273.15
Btmax tmax 0 V = max(max((({TS1_EN})>0.5 ? V(t1) : -100), (({TS2_EN})>0.5 ? V(t2) : -100)), (({TS3_EN})>0.5 ? V(t3) : -100))
Btmin tmin 0 V = min(min((({TS1_EN})>0.5 ? V(t1) : 200), (({TS2_EN})>0.5 ? V(t2) : 200)), (({TS3_EN})>0.5 ? V(t3) : 200))

* ---- primary protections (fault latches f_xxx) ----
* COV
Bc_cov c_cov 0 V = V(act)>0.5 && (({OV_TH})>0 && V(vmax) > ({OV_TH}))
Xd_cov c_cov s_cov BQ76952_DLY TD={OV_DLY}
